self = <test_proof_key.TestBTransformations object at 0x7fbee0385ba0>

    def test_joint_swap_two_slot_clause(self):
        # K3 JOIN and K4 bridge: only the final rule's body and the final step's
        # premise_steps are reversed (facts, head, and other steps untouched); the
        # verifier accepts both and the full key is unchanged.
        cA = (_fact("p", "a", "b"), _fact("q", "b", "c"),
               Clause((_A("p", "?x", "?y"), _A("q", "?y", "?z")),
                      _A("r", "?x", "?z")))
        pA = (_ps(0, (), "p", "a", "b"), _ps(1, (), "q", "b", "c"),
               _ps(2, (0, 1), "r", "a", "c"))
        # same world, final rule body + refs reversed only
        cB = (cA[0], cA[1],
               Clause((cA[2].body[1], cA[2].body[0]), cA[2].head))
        pB = (_ps(0, (), "p", "a", "b"), _ps(1, (), "q", "b", "c"),
               _ps(2, (1, 0), "r", "a", "c"))
        assert cA[2].body != cB[2].body
        assert cA[2].head == cB[2].head
        assert pA[-1].premise_steps != pB[-1].premise_steps
        assert verify_proof(cA, _A("r", "a", "c"), pA) is True
        assert verify_proof(cB, _A("r", "a", "c"), pB) is True
        assert key(cA, _A("r", "a", "c"), pA) == key(cB, _A("r", "a", "c"), pB)
    
        # K4 bridge (non-identical body atoms p(x,z)/p(x,w)); same swap, same key
        cC = (_fact("p", "a", "a"), _fact("p", "a", "c"),
               Clause((_A("p", "?x", "?z"), _A("p", "?x", "?w")),
                      _A("q", "?x", "?x")))
        pC = (_ps(0, (), "p", "a", "a"), _ps(1, (), "p", "a", "c"),
               _ps(2, (0, 1), "q", "a", "a"))
        cD = (cC[0], cC[1],
               Clause((cC[2].body[1], cC[2].body[0]), cC[2].head))
        pD = (_ps(0, (), "p", "a", "a"), _ps(1, (), "p", "a", "c"),
               _ps(2, (1, 0), "q", "a", "a"))
        assert cC[2].body != cD[2].body
        assert cC[2].head == cD[2].head
        assert pC[-1].premise_steps != pD[-1].premise_steps
        assert verify_proof(cC, _A("q", "a", "a"), pC) is True
        assert verify_proof(cD, _A("q", "a", "a"), pD) is True
>       assert key(cC, _A("q", "a", "a"), pC) == key(cD, _A("q", "a", "a"), pD)
