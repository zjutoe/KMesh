    @pytest.mark.parametrize("field", [
        "clauses", "member", "query",
        "max_fact_checks", "max_derivations", "both_positive",
    ])
    def test_large_integer_diagnostics(field, capped_int_str_limit):
        big = 10 ** 5000
        world = (fact("p"),)
        if field == "clauses":
